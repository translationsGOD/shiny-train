# ─── CAPA DE DATOS ────────────────────────────────────────────────────────────
def get_connection():
    return mysql.connector.connect(**DB_CONFIG)


def fetch_all_canciones():
    conn = get_connection()
    cur = conn.cursor()
    cur.execute("""
        SELECT c.id_cancion, c.titulo, a.nombre, 
               COALESCE(l.total_likes, 0) as likes,
               COALESCE(v.total_views, 0) as views
        FROM canciones c
        LEFT JOIN autores a ON c.id_autor = a.id_autor
        LEFT JOIN (SELECT id_cancion, COUNT(*) as total_likes FROM likes GROUP BY id_cancion) l 
            ON c.id_cancion = l.id_cancion
        LEFT JOIN (SELECT id_cancion, COUNT(*) as total_views FROM views GROUP BY id_cancion) v 
            ON c.id_cancion = v.id_cancion
        ORDER BY c.titulo
    """)
    rows = cur.fetchall()
    conn.close()
    return rows


def insert_cancion(titulo, id_autor):
    conn = get_connection()
    cur = conn.cursor()
    cur.execute(
        "INSERT INTO canciones (titulo, id_autor) VALUES (%s, %s)",
        (titulo, id_autor),
    )
    conn.commit()
    conn.close()


def update_cancion(id_cancion, titulo, id_autor):
    conn = get_connection()
    cur = conn.cursor()
    cur.execute(
        "UPDATE canciones SET titulo=%s, id_autor=%s WHERE id_cancion=%s",
        (titulo, id_autor, id_cancion),
    )
    conn.commit()
    conn.close()


def delete_cancion(id_cancion):
    conn = get_connection()
    cur = conn.cursor()
    cur.execute("DELETE FROM playlist_canciones WHERE id_cancion=%s", (id_cancion,))
    cur.execute("DELETE FROM likes WHERE id_cancion=%s", (id_cancion,))
    cur.execute("DELETE FROM views WHERE id_cancion=%s", (id_cancion,))
    cur.execute("DELETE FROM canciones WHERE id_cancion=%s", (id_cancion,))
    conn.commit()
    conn.close()


def fetch_all_autores():
    conn = get_connection()
    cur = conn.cursor()
    cur.execute("SELECT id_autor, nombre FROM autores ORDER BY nombre")
    rows = cur.fetchall()
    conn.close()
    return rows


def fetch_all_playlists():
    conn = get_connection()
    cur = conn.cursor()
    cur.execute("""
        SELECT p.id_playlist, u.nombre, COUNT(pc.id_cancion) as total_canciones
        FROM playlist p
        LEFT JOIN usuarios u ON p.id_usuario = u.id_usuario
        LEFT JOIN playlist_canciones pc ON p.id_playlist = pc.id_playlist
        GROUP BY p.id_playlist, u.nombre
        ORDER BY p.id_playlist
    """)
    rows = cur.fetchall()
    conn.close()
    return rows


def fetch_all_usuarios():
    conn = get_connection()
    cur = conn.cursor()
    cur.execute("SELECT id_usuario, nombre FROM usuarios ORDER BY nombre")
    rows = cur.fetchall()
    conn.close()
    return rows


def fetch_canciones_playlist(id_playlist):
    conn = get_connection()
    cur = conn.cursor()
    cur.execute("""
        SELECT c.id_cancion, c.titulo, a.nombre
        FROM playlist_canciones pc
        JOIN canciones c ON pc.id_cancion = c.id_cancion
        LEFT JOIN autores a ON c.id_autor = a.id_autor
        WHERE pc.id_playlist = %s
        ORDER BY c.titulo
    """, (id_playlist,))
    rows = cur.fetchall()
    conn.close()
    return rows


def add_like(id_usuario, id_cancion):
    conn = get_connection()
    cur = conn.cursor()
    try:
        cur.execute(
            "INSERT INTO likes (id_usuario, id_cancion) VALUES (%s, %s)",
            (id_usuario, id_cancion),
        )
        conn.commit()
        return True
    except Error as e:
        if "Duplicate" in str(e):
            messagebox.showinfo("Ya existe", "Este like ya fue registrado.")
        return False
    finally:
        conn.close()


def add_view(id_cancion):
    conn = get_connection()
    cur = conn.cursor()
    cur.execute(
        "INSERT INTO views (id_cancion, fecha_lanzamiento) VALUES (%s, %s)",
        (id_cancion, datetime.now().date()),
    )
    conn.commit()
    conn.close()


