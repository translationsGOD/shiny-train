    # ── Logica de Canciones ─────────────────────────────────────────────────
    def _load_data(self):
        for item in self.tree.get_children():
            self.tree.delete(item)
        try:
            rows = fetch_all_canciones()
            for i, (id_cancion, titulo, autor, likes, views) in enumerate(rows):
                tag = "odd" if i % 2 else "even"
                self.tree.insert(
                    "",
                    "end",
                    values=(id_cancion, titulo, autor or "Sin autor", likes, views),
                    tags=(tag,),
                )
            self._set_status(f"{len(rows)} canciones cargadas.")
        except Error as e:
            messagebox.showerror("Error de conexion", str(e))

    def _load_autores(self):
        try:
            autores = fetch_all_autores()
            autor_dict = {f"{id_autor} - {nombre}": id_autor for id_autor, nombre in autores}
            self.autor_map = autor_dict
            self.combo_autor['values'] = list(autor_dict.keys())
        except Error as e:
            messagebox.showerror("Error", f"No se pudieron cargar los autores: {e}")

    def _load_playlists(self):
        self.playlist_listbox.delete(0, tk.END)
        try:
            playlists = fetch_all_playlists()
            self.playlist_data = {}
            for id_playlist, usuario, total in playlists:
                text = f"Playlist {id_playlist} - {usuario} ({total} canciones)"
                self.playlist_data[text] = id_playlist
                self.playlist_listbox.insert(tk.END, text)
            self._set_status(f"{len(playlists)} playlists cargadas.")
        except Error as e:
            messagebox.showerror("Error", f"No se pudieron cargar las playlists: {e}")

    def _on_select_cancion(self, _event=None):
        sel = self.tree.selection()
        if not sel:
            return
        id_cancion, titulo, autor, likes, views = self.tree.item(sel[0], "values")
        self._selected_id = int(id_cancion)
        self.var_titulo.set(titulo)
        
        # Buscar el autor en el combobox
        for key in self.autor_map:
            if autor in key:
                self.var_autor.set(key)
                break

    def _on_select_playlist(self, _event=None):
        sel = self.playlist_listbox.curselection()
        if not sel:
            return
        playlist_text = self.playlist_listbox.get(sel[0])
        id_playlist = self.playlist_data[playlist_text]
        
        self.playlist_canciones_listbox.delete(0, tk.END)
        try:
            canciones = fetch_canciones_playlist(id_playlist)
            for id_cancion, titulo, autor in canciones:
                self.playlist_canciones_listbox.insert(
                    tk.END, f"{titulo} - {autor or 'Sin autor'}"
                )
        except Error as e:
            messagebox.showerror("Error", str(e))

    def _save_cancion(self):
        titulo = self.var_titulo.get().strip()
        autor_key = self.var_autor.get()

        if not titulo or not autor_key:
            messagebox.showwarning("Campos incompletos", "Completa todos los campos.")
            return

        id_autor = self.autor_map[autor_key]

        try:
            if self._selected_id:
                update_cancion(self._selected_id, titulo, id_autor)
                self._set_status(f"Cancion '{titulo}' actualizada.")
            else:
                insert_cancion(titulo, id_autor)
                self._set_status(f"Cancion '{titulo}' insertada.")
            self._clear_cancion()
            self._load_data()
        except Error as e:
            messagebox.showerror("Error MySQL", str(e))

    def _delete_cancion(self):
        if not self._selected_id:
            messagebox.showinfo("Sin seleccion", "Selecciona una cancion en la tabla.")
            return
        if not messagebox.askyesno("Confirmar", "Eliminar la cancion seleccionada?"):
            return
        try:
            delete_cancion(self._selected_id)
            self._set_status("Cancion eliminada.")
            self._clear_cancion()
            self._load_data()
        except Error as e:
            messagebox.showerror("Error MySQL", str(e))

    def _dar_like(self):
        if not self._selected_id:
            messagebox.showinfo("Sin seleccion", "Selecciona una cancion.")
            return
        
        try:
            usuarios = fetch_all_usuarios()
            if not usuarios:
                messagebox.showwarning("Sin usuarios", "No hay usuarios registrados.")
                return
            
            # Dialogo simple para seleccionar usuario
            dialog = tk.Toplevel(self)
            dialog.title("Seleccionar Usuario")
            dialog.geometry("300x200")
            dialog.configure(bg=COLOR_PANEL)
            
            tk.Label(dialog, text="Selecciona un usuario:", bg=COLOR_PANEL, fg=COLOR_TEXT, font=FONT_LABEL).pack(pady=10)
            
            combo = ttk.Combobox(dialog, values=[f"{id_u} - {nombre}" for id_u, nombre in usuarios], state="readonly")
            combo.pack(pady=10)
            
            def confirm_like():
                if not combo.get():
                    messagebox.showwarning("Seleccion requerida", "Selecciona un usuario.")
                    return
                id_usuario = int(combo.get().split(" - ")[0])
                if add_like(id_usuario, self._selected_id):
                    self._load_data()
                    messagebox.showinfo("Exito", "Like registrado.")
                dialog.destroy()
            
            tk.Button(dialog, text="Confirmar", command=confirm_like, bg=COLOR_ACCENT, fg="white").pack(pady=10)
            
        except Error as e:
            messagebox.showerror("Error", str(e))

    def _registrar_view(self):
        if not self._selected_id:
            messagebox.showinfo("Sin seleccion", "Selecciona una cancion.")
            return
        try:
            add_view(self._selected_id)
            self._load_data()
            messagebox.showinfo("Exito", "View registrada.")
        except Error as e:
            messagebox.showerror("Error", str(e))

    def _clear_cancion(self):
        self._selected_id = None
        self.var_titulo.set("")
        self.var_autor.set("")
        for item in self.tree.selection():
            self.tree.selection_remove(item)

    def _load_stats(self):
        try:
            conn = get_connection()
            cur = conn.cursor()
            
            # Total canciones
            cur.execute("SELECT COUNT(*) FROM canciones")
            total_canciones = cur.fetchone()[0]
            
            # Total autores
            cur.execute("SELECT COUNT(*) FROM autores")
            total_autores = cur.fetchone()[0]
            
            # Total usuarios
            cur.execute("SELECT COUNT(*) FROM usuarios")
            total_usuarios = cur.fetchone()[0]
            
            # Cancion mas likeada
            cur.execute("""
                SELECT c.titulo, COUNT(*) as likes
                FROM likes l
                JOIN canciones c ON l.id_cancion = c.id_cancion
                GROUP BY l.id_cancion
                ORDER BY likes DESC
                LIMIT 1
            """)
            most_liked = cur.fetchone()
            
            # Cancion mas vista
            cur.execute("""
                SELECT c.titulo, COUNT(*) as views
                FROM views v
                JOIN canciones c ON v.id_cancion = c.id_cancion
                GROUP BY v.id_cancion
                ORDER BY views DESC
                LIMIT 1
            """)
            most_viewed = cur.fetchone()
            
            conn.close()
            
            stats = f"""
